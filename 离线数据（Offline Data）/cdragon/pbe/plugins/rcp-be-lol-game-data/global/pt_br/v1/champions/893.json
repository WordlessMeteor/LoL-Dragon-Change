    "passive": {
        "name": "Abjuração Espiritual",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Aurora/HUD/Icons2D/AuroraPassive.Aurora.png",
        "abilityVideoPath": "champion-abilities/0893/ability_0893_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0893/ability_0893_P1.jpg",
        "description": "As Habilidades e Ataques da Aurora exorcizam espíritos dos inimigos aos quais ela causa dano. Espíritos exorcizados seguem Aurora, concedendo cura e Velocidade de Movimento adicional a ela."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Feitiço Dúplice",
