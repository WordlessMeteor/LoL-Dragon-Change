    "passive": {
        "name": "ドレイクハウンドの猛攻",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Ambessa/HUD/Icons2D/Icon_Ambessa_Passive.Domina.png",
        "abilityVideoPath": "",
        "abilityVideoImagePath": "",
        "description": "スキル使用中に攻撃するか移動を指示すると、スキル使用後に短いダッシュをして、自身の次の通常攻撃の射程距離、ダメージ、攻撃速度が増加し、気を回復する。"
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "カニングスイープ / サンダリングスラム",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Ambessa/HUD/Icons2D/Icon_Ambessa_Q1.Domina.png",
            "abilityVideoPath": "",
            "abilityVideoImagePath": "",
            "cost": "@Cost@@AbilityResourceName@",
            "cooldown": "@Cooldown@秒 %i:cooldown%",
            "description": "両手のドレイクハウンドで自身の前方を半円状になぎ払う。刃が当たった敵には追加ダメージを与える。敵に命中すると、次に使用するこのスキルが短時間変化し、自身の前方に両手のドレイクハウンドを直線状に叩きつけ、最初に命中した敵に追加ダメージを与える。",
            "dynamicDescription": "<spellActive>カニングスイープ</spellActive>: 両手の武器を自分の前方に向かって振り回し、範囲の最端部にいる敵に<physicalDamage>@Calc_Damage_1_Max@ + 最大体力の@Calc_Damage_1_Percent_Max@の物理ダメージ</physicalDamage>を与える。その他の敵はすべて@Calc_Damage_1_Min_Ratio@のダメージを受ける。その後「<spellActive>サンダリングスラム</spellActive>」を構える。<br><br><spellActive>サンダリングスラム</spellActive>: 敵に刃を叩きつけ、最初に当たった敵に<physicalDamage>@Calc_Damage_2_Max@ + 最大体力の@Calc_Damage_2_Percent_Max@の物理ダメージ</physicalDamage>を与える。その他の敵はすべて@Calc_Damage_2_Min_Ratio@のダメージを受ける。@SpellModifierDescriptionAppend@",
