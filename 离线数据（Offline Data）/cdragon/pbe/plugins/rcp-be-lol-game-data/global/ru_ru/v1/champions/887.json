            "name": "Чик-чик!",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Gwen/HUD/Icons2D/Gwen_Q.png",
            "abilityVideoPath": "champion-abilities/0887/ability_0887_Q1.webm",
