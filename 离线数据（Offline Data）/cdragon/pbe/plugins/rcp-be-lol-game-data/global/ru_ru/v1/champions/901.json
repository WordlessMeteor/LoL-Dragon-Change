        {
            "spellKey": "r",
            "name": "МА-А-АМ!",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Smolder/HUD/Icons2D/Icons_Smolder_R.png",
            "abilityVideoPath": "champion-abilities/0901/ability_0901_R1.webm",
            "abilityVideoImagePath": "champion-abilities/0901/ability_0901_R1.jpg",
            "cost": "@AbilityResourceName@: @Cost@",
