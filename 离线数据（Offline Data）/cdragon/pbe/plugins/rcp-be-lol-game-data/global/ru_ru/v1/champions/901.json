            "description": "Смолдер – самый юный член королевской семьи и двоюродный брат Ли Сина, который обожает сопровождать принца в его приключениях. Правда, отправляясь на праздник, Смолдер забыл замаскироваться под человека, но не беда: зато он сможет показать смертным, что никто не зажигает лучше драконов!"
        }
    ],
    "passive": {
        "name": "Драконья тренировка",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Smolder/HUD/Icons2D/Icons_Smolder_Passive.png",
        "abilityVideoPath": "champion-abilities/0901/ability_0901_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0901/ability_0901_P1.jpg",
        "description": "Когда Смолдер поражает чемпионов умениями или убивает врагов Супержарким дыханием, он получает заряд Драконьей тренировки. Заряды увеличивают урон базовых умений Смолдера."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Супержаркое дыхание",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Smolder/HUD/Icons2D/Icons_Smolder_Q1.png",
            "abilityVideoPath": "champion-abilities/0901/ability_0901_Q1.webm",
