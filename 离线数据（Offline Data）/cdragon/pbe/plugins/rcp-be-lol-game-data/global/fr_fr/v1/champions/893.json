        {
            "spellKey": "r",
            "name": "Entre les mondes",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Aurora/HUD/Icons2D/AuroraR.Aurora.png",
            "abilityVideoPath": "champion-abilities/0893/ability_0893_R1.webm",
