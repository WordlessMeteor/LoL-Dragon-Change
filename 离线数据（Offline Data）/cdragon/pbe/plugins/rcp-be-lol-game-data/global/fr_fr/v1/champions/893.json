    "passive": {
        "name": "Abjuration spirituelle",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Aurora/HUD/Icons2D/AuroraPassive.Aurora.png",
        "abilityVideoPath": "champion-abilities/0893/ability_0893_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0893/ability_0893_P1.jpg",
        "description": "Aurora exorcise les esprits des ennemis qu'elle blesse avec ses compétences et ses attaques. Les esprits exorcisés la suivent, lui rendant des PV et lui octroyant de la vitesse de déplacement bonus."
    },
