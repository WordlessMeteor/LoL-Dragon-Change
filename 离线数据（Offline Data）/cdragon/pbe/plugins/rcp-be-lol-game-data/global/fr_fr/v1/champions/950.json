    "passive": {
        "name": "La meute s'agrandit",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Naafiri/HUD/Icons2D/Icons_Naafiri_P.png",
        "abilityVideoPath": "champion-abilities/0950/ability_0950_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0950/ability_0950_P1.jpg",
        "description": "Naafiri fait apparaître des membres de meute qui attaquent les cibles de ses attaques et de ses compétences."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Dagues des Darkin",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Naafiri/HUD/Icons2D/Icons_Naafiri_Q.png",
            "abilityVideoPath": "champion-abilities/0950/ability_0950_Q1.webm",
            "abilityVideoImagePath": "champion-abilities/0950/ability_0950_Q1.jpg",
            "cost": "@Cost@ @AbilityResourceName@",
            "cooldown": "@Cooldown@ sec %i:cooldown%",
            "description": "Naafiri lance jusqu'à deux dagues qui appliquent chacune un saignement, ou qui infligent des dégâts supplémentaires si la cible saigne déjà.<br><br>Les membres de meute bondissent pour attaquer les champions touchés par cette compétence.<br>",
            "dynamicDescription": "Naafiri lance des lames des Darkin, infligeant <physicalDamage>@spell.NaafiriQ:TotalDamageFirstCast@ pts de dégâts physiques</physicalDamage> et appliquant un saignement qui inflige <physicalDamage>@spell.NaafiriQ:TotalBleedDamage@ pts de dégâts physiques</physicalDamage> en @spell.NaafiriQ:BleedDuration@ sec.<br><br>Naafiri peut <recast>relancer</recast> cette compétence. Si l'ennemi touché subit déjà le saignement de cette compétence, elle lui inflige à la place les dégâts de saignement restants et <physicalDamage>@spell.NaafiriQ:TotalMinDamageSecondCast@</physicalDamage>-<physicalDamage>@spell.NaafiriQ:TotalMaxDamageSecondCast@ pts de dégâts physiques</physicalDamage> supplémentaires, en fonction des PV manquants de la cible. Si la cible était un champion ou un grand monstre, Naafiri récupère <healing>@spell.NaafiriQ:TotalHealSecondCast@ PV</healing>.<br><br>Les <keywordMajor>membres de meute</keywordMajor> bondissent sur le premier champion touché et l'attaquent pendant @spell.NaafiriP:PackmateTauntDuration@ sec.<br><br>@SpellModifierDescriptionAppend@",
