        {
            "spellKey": "w",
            "name": "Niebla Sagrada",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Gwen/HUD/Icons2D/Gwen_W.png",
            "abilityVideoPath": "champion-abilities/0887/ability_0887_W1.webm",
            "abilityVideoImagePath": "champion-abilities/0887/ability_0887_W1.jpg",
            "cost": "@Cost@ de @AbilityResourceName@",
