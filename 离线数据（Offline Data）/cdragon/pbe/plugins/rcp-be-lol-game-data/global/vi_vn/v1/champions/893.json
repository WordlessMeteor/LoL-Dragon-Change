    "passive": {
        "name": "Thanh Tẩy Linh Hồn",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Aurora/HUD/Icons2D/AuroraPassive.Aurora.png",
        "abilityVideoPath": "champion-abilities/0893/ability_0893_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0893/ability_0893_P1.jpg",
        "description": "Đòn đánh và kỹ năng của Aurora sẽ thanh tẩy linh hồn trên những kẻ địch mà cô gây sát thương lên. Linh hồn được thanh tẩy sẽ đi theo Aurora, hồi máu và tăng thêm tốc độ di chuyển cho cô."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Bùa Chú Tâm Linh",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Aurora/HUD/Icons2D/AuroraQ.Aurora.png",
            "abilityVideoPath": "champion-abilities/0893/ability_0893_Q1.webm",
