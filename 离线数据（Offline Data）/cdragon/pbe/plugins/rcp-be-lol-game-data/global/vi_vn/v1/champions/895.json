        {
            "spellKey": "w",
            "name": "Thủy Giáp Bảo Hộ",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Nilah/HUD/Icons2D/NilahW.png",
            "abilityVideoPath": "champion-abilities/0895/ability_0895_W1.webm",
            "abilityVideoImagePath": "champion-abilities/0895/ability_0895_W1.jpg",
            "cost": "@Cost@ @AbilityResourceName@",
