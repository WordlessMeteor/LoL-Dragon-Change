        {
            "spellKey": "r",
            "name": "القوة الجامحة",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/KSante/HUD/Icons2D/Icons_KSante_R1.png",
            "abilityVideoPath": "champion-abilities/0897/ability_0897_R1.webm",
