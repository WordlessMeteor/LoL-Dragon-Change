    "passive": {
        "name": "Abiura spirituale",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Aurora/HUD/Icons2D/AuroraPassive.Aurora.png",
        "abilityVideoPath": "champion-abilities/0893/ability_0893_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0893/ability_0893_P1.jpg",
        "description": "Le abilità e gli attacchi di Aurora esorcizzano gli spiriti dai nemici a cui infligge danni. Gli spiriti esorcizzati la seguono sul campo di battaglia, curandola e conferendole velocità di movimento bonus."
    },
