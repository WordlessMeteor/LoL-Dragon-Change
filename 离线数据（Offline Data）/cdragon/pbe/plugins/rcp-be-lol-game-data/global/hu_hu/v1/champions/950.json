        {
            "spellKey": "e",
            "name": "Kizsigerelés",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Naafiri/HUD/Icons2D/Icons_Naafiri_E.png",
            "abilityVideoPath": "champion-abilities/0950/ability_0950_E1.webm",
            "abilityVideoImagePath": "champion-abilities/0950/ability_0950_E1.jpg",
            "cost": "@Cost@ @AbilityResourceName@",
            "cooldown": "@Cooldown@ mp %i:cooldown%",
            "description": "Naafiri a körülötte lévő ellenségek irányába rohamoz, és megsebzi őket, magához hívja a falkatagjait, és teljesen meggyógyítja őket.",
            "dynamicDescription": "Naafiri előreront, <physicalDamage>@TotalDamageFirstSlash@ fizikai sebzést</physicalDamage> okoz, majd pengevihart szabadít el, és <physicalDamage>@TotalDamageSecondSlash@ fizikai sebzést</physicalDamage> okoz.<br><br>Naafiri magához hívja a <keywordMajor>falkatagokat</keywordMajor>, akiknek az <healing>életereje 100%-ra áll vissza</healing>. <br>@SpellModifierDescriptionAppend@",
            "range": [
