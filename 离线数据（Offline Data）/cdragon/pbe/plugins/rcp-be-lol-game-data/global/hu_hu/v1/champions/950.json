    "passive": {
        "name": "Többen vagyunk",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Naafiri/HUD/Icons2D/Icons_Naafiri_P.png",
        "abilityVideoPath": "champion-abilities/0950/ability_0950_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0950/ability_0950_P1.jpg",
        "description": "Naafiri falkatársakat idéz meg, amelyek a támadásai és a képességei célpontját támadják."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Darkin tőrök",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Naafiri/HUD/Icons2D/Icons_Naafiri_Q.png",
            "abilityVideoPath": "champion-abilities/0950/ability_0950_Q1.webm",
            "abilityVideoImagePath": "champion-abilities/0950/ability_0950_Q1.jpg",
            "cost": "@Cost@ @AbilityResourceName@",
            "cooldown": "@Cooldown@ mp %i:cooldown%",
            "description": "Naafiri legfeljebb két tőrt hajít el, amelyek egyenként vérzést okoznak, vagy bónusz sebzést, ha a célpont már vérzik.<br><br>A falkatársak az ezzel a képességgel eltalált hősökre ugranak.<br>",
            "dynamicDescription": "Naafiri darkin erővel átitatott pengéket hajít el, amelyek <physicalDamage>@spell.NaafiriQ:TotalDamageFirstCast@ fizikai sebzést</physicalDamage> okoznak, és @spell.NaafiriQ:BleedDuration@ másodpercre <physicalDamage>@spell.NaafiriQ:TotalBleedDamage@ fizikai sebzést</physicalDamage> okozó vérzést idéznek elő a célpontnál.<br><br>Naafiri <recast>újraaktiválhatja</recast> ezt a képességét. Ha a képességgel eltalált ellenfél már vérzik, ehelyett a fennmaradó vérzést kiváltó sebzés mellett <physicalDamage>@spell.NaafiriQ:TotalMinDamageSecondCast@</physicalDamage> és <physicalDamage>@spell.NaafiriQ:TotalMaxDamageSecondCast@ közötti fizikai sebzést</physicalDamage> szenved el a hiányzó életereje alapján. Ha a célpont egy hős vagy nagy szörny volt, Naafiri visszatölt <healing>@spell.NaafiriQ:TotalHealSecondCast@ életerőt</healing>.<br><br>A <keywordMajor>falkatagok</keywordMajor> az első eltalált ellenfélre ugranak, előnyben részesítve a hősöket, és @spell.NaafiriP:PackmateTauntDuration@ másodpercig támadják őt. <br><br>@SpellModifierDescriptionAppend@",
