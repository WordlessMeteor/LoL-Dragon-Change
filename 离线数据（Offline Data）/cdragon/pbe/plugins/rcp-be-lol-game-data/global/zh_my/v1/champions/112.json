    "passive": {
        "name": "荣光进化",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Viktor/HUD/Icons2D/Viktor_Passive.ViktorVGU.png",
        "abilityVideoPath": "",
        "abilityVideoImagePath": "",
        "description": "维克特会在击杀一名敌人后获得海克斯碎片。每获得100个海克斯碎片即可使维克特永久增强一个主动技能。在升级所有基础技能后，维克特可以收集100个海克斯碎片来增强他的终极技能。"
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "能量守恒",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Viktor/HUD/Icons2D/Viktor_Q1.ViktorVGU.png",
            "abilityVideoPath": "champion-abilities/0112/ability_0112_Q1.webm",
            "abilityVideoImagePath": "champion-abilities/0112/ability_0112_Q1.jpg",
            "cost": "@Cost@ @AbilityResourceName@",
            "cooldown": "@Cooldown@ 秒 %i:cooldown%",
            "description": "维克特引爆一个敌方单位，造成魔法伤害，为自己提供护盾并强化下一次普攻。<br><br>增强：能量守恒的护盾值提升60%，施放技能后维克特获得额外移动速度。<br>",
