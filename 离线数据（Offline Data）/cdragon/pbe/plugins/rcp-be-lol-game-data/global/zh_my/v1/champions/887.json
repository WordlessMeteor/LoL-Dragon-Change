    "passive": {
        "name": "千刀万剐",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Gwen/HUD/Icons2D/Gwen_Passive.png",
        "abilityVideoPath": "champion-abilities/0887/ability_0887_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0887/ability_0887_P1.jpg",
        "description": "关的攻击会根据目标生命造成额外魔法伤害。她自身会获得相当于此效果对英雄造成部分伤害的回复量。"
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "剪剪！",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Gwen/HUD/Icons2D/Gwen_Q.png",
            "abilityVideoPath": "champion-abilities/0887/ability_0887_Q1.webm",
            "abilityVideoImagePath": "champion-abilities/0887/ability_0887_Q1.jpg",
            "cost": "@Cost@ @AbilityResourceName@",
            "cooldown": "@Cooldown@ 秒 %i:cooldown%",
            "description": "关在一个锥形范围裁剪她的剪刀最多 6 次，造成魔法伤害。关的每次裁剪会对正中央的敌人造成真实伤害并对他们附加她的被动技能。",
            "dynamicDescription": "<spellPassive>被动</spellPassive>：关的每次普攻在命中敌人时会获得 1 层叠层（最多 4 层，持续 @BuffDuration@ 秒）。<br><br><spellActive>主动</spellActive>：消耗所有叠层。关进行一次裁剪，造成 <magicDamage>@MiniSwipeDamage@ 魔法伤害</magicDamage>，每消耗 1 层叠层便会多进行一次裁剪。接着会进行一次最终裁剪，造成 <magicDamage>@FinalSwipeDamage@ 魔法伤害</magicDamage>。<br><br>每次裁剪的中央区域会将伤害的 @TrueDamageConversion*100@% 改为造成<trueDamage>真实伤害</trueDamage>，并对命中的敌人附加<spellName>千刀万剐</spellName>。<br><rules><br>对小兵造成 @MinionMod*100@% 伤害。<br>低于 @ExecuteThreshold*100@% 生命的小兵将改为受到 @ExecuteBonus@% 额外伤害，而不是减少伤害。</rules>@SpellModifierDescriptionAppend@",
