    "passive": {
        "name": "Čas v láhvi",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Zilean/HUD/Icons2D/Zilean_Passive.png",
        "abilityVideoPath": "champion-abilities/0026/ability_0026_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0026/ability_0026_P1.jpg",
        "description": "Zilean si ukládá čas jako zkušenosti, které může následně udělit svým spojencům. Až nastřádá dostatek zkušeností na to, aby dokončil úroveň svého spojence, může na něj kliknout pravým tlačítkem a tím mu je předat. Zilean obdrží stejné množství zkušeností, kolik jich předal."
    },
