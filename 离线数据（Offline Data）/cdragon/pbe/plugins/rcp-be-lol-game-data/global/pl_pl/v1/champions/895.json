    "passive": {
        "name": "Nieskończona Radość",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Nilah/HUD/Icons2D/NIlahP.png",
        "abilityVideoPath": "champion-abilities/0895/ability_0895_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0895/ability_0895_P1.jpg",
        "description": "Nilah otrzymuje więcej doświadczenia za zadawanie ostatnich ciosów stworom, a także możliwość wzmocnienia i współdzielenia pobliskiego leczenia oraz tarczy od pobliskich sojuszników."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Bezkształtne Ostrze",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Nilah/HUD/Icons2D/NilahQ.png",
            "abilityVideoPath": "champion-abilities/0895/ability_0895_Q1.webm",
            "abilityVideoImagePath": "champion-abilities/0895/ability_0895_Q1.jpg",
            "cost": "@Cost@ pkt. (@AbilityResourceName@)",
            "cooldown": "@Cooldown@ sek. %i:cooldown%",
            "description": "Strzelając swoim biczo-ostrzem, Nilah zadaje obrażenia trafionym w prostej linii wrogom w wybranym przez nią kierunku. To działanie przez krótki czas zwiększa zasięg jej ataku.",
            "dynamicDescription": "<spellPassive>Umiejętność bierna:</spellPassive> Nilah zyskuje @CritArmorPen@ pkt. przebicia pancerza, a jej ataki przeciwko bohaterom przywracają jej <healing>@CritLifesteal@ pkt. zadanych obrażeń jako zdrowie</healing>. Powstałe w ten sposób przeleczenie zostaje przemienione w <shield>tarczę</shield> na @ShieldDuration@ sek.<br><br><spellActive>Użycie:</spellActive> Nilah używa swojego biczo-ostrza, zadając <physicalDamage>@DamageCalc@ pkt. obrażeń fizycznych</physicalDamage> wzmocnionych przez jej szansę na trafienie krytyczne. W przypadku trafienia wrogiej jednostki lub budowli Nilah zyskuje 125 jedn. zasięgu ataku i <attackSpeed>@BonusAttackSpeedCalc@% prędkości ataku</attackSpeed>, a jej ataki trafiają w formie stożka, zadając <physicalDamage>@AttackTotalDamageTooltip@ pkt. obrażeń fizycznych</physicalDamage> przez @BuffDuration@ sek.<br>@SpellModifierDescriptionAppend@",
