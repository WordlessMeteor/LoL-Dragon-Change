    "passive": {
        "name": "Duchowe Wsparcie",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Aurora/HUD/Icons2D/AuroraPassive.Aurora.png",
        "abilityVideoPath": "champion-abilities/0893/ability_0893_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0893/ability_0893_P1.jpg",
        "description": "Zaklęcia i ataki Aurory egzorcyzmują duchy z wrogów, którym zadała obrażenia. Egzorcyzmowane duchy podążają za Aurorą, lecząc ją i zapewniając jej dodatkową prędkość ruchu."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Podwójny Urok",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Aurora/HUD/Icons2D/AuroraQ.Aurora.png",
            "abilityVideoPath": "champion-abilities/0893/ability_0893_Q1.webm",
            "abilityVideoImagePath": "champion-abilities/0893/ability_0893_Q1.jpg",
            "cost": "@Cost@ pkt. (@AbilityResourceName@)",
            "cooldown": "@Cooldown@ sek. %i:cooldown%",
            "description": "Aurora wysyła pocisk, który nakłada klątwę na trafionych wrogów. Może powtórnie użyć tej umiejętności, aby przyciągnąć do siebie aktywne klątwy, zadając obrażenia wrogom, którzy zostaną nimi przy okazji trafieni.",
            "dynamicDescription": "Aurora wysyła ukierunkowany wybuch przeklętej energii, zadając <magicDamage>@damage@ pkt. obrażeń magicznych</magicDamage> wrogom i przeklinając ich na @MarkDuration@ sek.<br><br><recast>Ponowne użycie:</recast> Aurora kończy klątwę i przyciąga do siebie fragment duszy przeciwnika, zadając <magicDamage>@Q2DamageMax@ pkt. obrażeń magicznych</magicDamage> zależnych od brakującego zdrowia wrogom, przez których ta energia przeniknie. Po trafieniu pierwszego wroga obrażenia zadawane kolejnym przeciwnikom zmniejszone są do 20%.@SpellModifierDescriptionAppend@",
