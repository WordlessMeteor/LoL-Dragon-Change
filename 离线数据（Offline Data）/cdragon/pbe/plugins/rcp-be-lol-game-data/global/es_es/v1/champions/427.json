    "passive": {
        "name": "Amigo del Bosque",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Ivern/HUD/Icons2D/IvernP.png",
        "abilityVideoPath": "champion-abilities/0427/ability_0427_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0427/ability_0427_P1.jpg",
        "description": "Ivern no puede atacar ni ser atacado por monstruos no épicos. Ivern puede crear arboledas mágicas que crecen con el tiempo en los campamentos de la jungla. Cuando la arboleda ha crecido por completo, Ivern puede liberar a los monstruos para recibir oro y experiencia."
    },
