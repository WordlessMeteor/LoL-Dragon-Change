    "passive": {
        "name": "Abjuración espiritual",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Aurora/HUD/Icons2D/AuroraPassive.Aurora.png",
        "abilityVideoPath": "champion-abilities/0893/ability_0893_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0893/ability_0893_P1.jpg",
        "description": "Las habilidades y ataques de Aurora exorcizan espíritus de los enemigos a los que inflige daño. Los espíritus exorcizados siguen a Aurora, la curan y le otorgan velocidad de movimiento adicional."
    },
