        {
            "spellKey": "e",
            "name": "Juego de pies",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/KSante/HUD/Icons2D/Icons_KSante_E.png",
            "abilityVideoPath": "champion-abilities/0897/ability_0897_E1.webm",
            "abilityVideoImagePath": "champion-abilities/0897/ability_0897_E1.jpg",
            "cost": "@Cost@ @AbilityResourceName@",
            "cooldown": "@Cooldown@ s %i:cooldown%",
            "description": "K'Sante se deslizará hacia un aliado y ambos obtendrán un escudo. Si no hay aliados, K'Sante seguirá desplazándose hacia la ubicación con un alcance reducido y obtendrá un escudo.<br>",
            "dynamicDescription": "K'Sante se desliza y obtiene un <shield>escudo de @TotalShield@</shield> durante @ShieldDuration@ s. Si se desliza hasta un aliado, la distancia del deslizamiento aumenta significativamente y el aliado también <shield>recibe un escudo</shield>.<br><br><keywordMajor>Órdago</keywordMajor>: Aumenta la velocidad del deslizamiento de esta habilidad. Además, aumenta el alcance del deslizamiento sin un aliado y puede saltar muros.@SpellModifierDescriptionAppend@",
            "range": [
                525.0,
                525.0,
                525.0,
                525.0,
                525.0,
                525.0
            ],
