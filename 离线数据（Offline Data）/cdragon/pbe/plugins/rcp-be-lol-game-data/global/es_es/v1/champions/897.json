    "passive": {
        "name": "Instinto intrépido",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/KSante/HUD/Icons2D/Icons_KSante_P.png",
        "abilityVideoPath": "champion-abilities/0897/ability_0897_P1.webm",
