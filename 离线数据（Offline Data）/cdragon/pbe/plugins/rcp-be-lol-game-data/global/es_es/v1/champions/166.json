        {
            "spellKey": "e",
            "name": "Balanceo heroico",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Akshan/HUD/Icons2D/akshan_e.png",
            "abilityVideoPath": "champion-abilities/0166/ability_0166_E1.webm",
