        "description": "Nilah mendapat peningkatan XP dari last-hit ke minion bersama ability untuk memperkuat dan berbagi heal serta shield dari sekutu di sekitar."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Formless Blade",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Nilah/HUD/Icons2D/NilahQ.png",
            "abilityVideoPath": "champion-abilities/0895/ability_0895_Q1.webm",
