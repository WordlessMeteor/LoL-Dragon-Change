        {
            "spellKey": "e",
            "name": "Juego de Pies",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/KSante/HUD/Icons2D/Icons_KSante_E.png",
            "abilityVideoPath": "champion-abilities/0897/ability_0897_E1.webm",
            "abilityVideoImagePath": "champion-abilities/0897/ability_0897_E1.jpg",
            "cost": "@Cost@ de @AbilityResourceName@",
            "cooldown": "@Cooldown@ seg %i:cooldown%",
            "description": "K'Sante se desplazará hacia un aliado y ambos obtendrán un escudo. Si no hay aliados cerca, K'Sante seguirá desplazándose hacia la ubicación en un alcance reducido y obtiene un escudo.<br>",
            "dynamicDescription": "K'Sante se desplaza y obtiene <shield>@TotalShield@ de Escudo</shield> por @ShieldDuration@ seg. Si se desplaza hacia un aliado, la distancia del desplazamiento aumenta significativamente y además <shield>protege</shield> al aliado.<br><br><keywordMajor>Con Todo</keywordMajor>: Aumenta la velocidad de desplazamiento de esta habilidad. El desplazamiento sin un aliado tiene un mayor alcance y puede pasar por encima de los muros.@SpellModifierDescriptionAppend@",
