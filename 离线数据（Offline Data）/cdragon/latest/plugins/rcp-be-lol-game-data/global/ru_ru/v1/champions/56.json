            "skinAugments": null,
            "description": "Ноктюрн – кошмарный межпространственный паразит, которого привлекла мощь Свечения. Пытаясь проникнуть в самое сердце этого источника энергии, он случайно вызвал первую пространственную катастрофу, породившую первого эмпирейца – Пайка. Изменившись до неузнаваемости, Ноктюрн продолжает экспериментировать с силой Свечения и искать новые способы утолить свой голод."
        }
    ],
    "passive": {
        "name": "Клинки чернейшей тени",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Nocturne/HUD/Icons2D/Nocturne_UmbraBlades.png",
        "abilityVideoPath": "champion-abilities/0056/ability_0056_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0056/ability_0056_P1.jpg",
        "description": "Каждые несколько секунд автоатака Ноктюрна наносит окружающим врагам дополнительный физический урон и восстанавливает ему здоровье.<br><br>Автоатаки Ноктюрна сокращают время перезарядки этого эффекта."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Вестник заката",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Nocturne/HUD/Icons2D/Nocturne_Duskbringer.png",
