    "passive": {
        "name": "Безрассудный порыв",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Samira/HUD/Icons2D/SamiraP.png",
        "abilityVideoPath": "champion-abilities/0360/ability_0360_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0360/ability_0360_P1.jpg",
        "description": "Попадая автоатаками или умениями, отличными от тех, которыми Самира попала перед этим, она выстраивает комбинацию. Автоатаки Самиры в ближнем бою наносят дополнительный магический урон. Когда Самира применяет автоатаки к врагам, на которых действуют эффекты <status>обездвиживания</status>, она совершает к ним рывок на расстояние дальности атаки. Если цель <status>подброшена</status>, продолжительность <status>подбрасывания</status> немного увеличивается."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Эпатаж",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Samira/HUD/Icons2D/SamiraQ.png",
            "abilityVideoPath": "champion-abilities/0360/ability_0360_Q1.webm",
            "abilityVideoImagePath": "champion-abilities/0360/ability_0360_Q1.jpg",
            "cost": "@AbilityResourceName@: @Cost@",
