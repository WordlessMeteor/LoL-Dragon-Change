    "passive": {
        "name": "Запал",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Milio/HUD/Icons2D/Milio_P.png",
        "abilityVideoPath": "champion-abilities/0902/ability_0902_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0902/ability_0902_P1.jpg",
        "description": "Умения Милио усиливают союзников при касании. Усиленный союзник наносит дополнительный урон и поджигает цель."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Огненный мяч",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Milio/HUD/Icons2D/Milio_Q.png",
