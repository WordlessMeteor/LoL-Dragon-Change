    "passive": {
        "name": "Рычаг давления",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Renata/HUD/Icons2D/Renata_P.png",
        "abilityVideoPath": "champion-abilities/0888/ability_0888_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0888/ability_0888_P1.jpg",
        "description": "Автоатаки Ренаты наносят дополнительный урон и помечают врагов. Когда союзники наносят урон помеченным врагам, те получают дополнительный урон."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Рукопожатие",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Renata/HUD/Icons2D/Renata_Q.png",
