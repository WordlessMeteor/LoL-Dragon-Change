        {
            "spellKey": "e",
            "name": "Jeu de jambes",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/KSante/HUD/Icons2D/Icons_KSante_E.png",
            "abilityVideoPath": "champion-abilities/0897/ability_0897_E1.webm",
            "abilityVideoImagePath": "champion-abilities/0897/ability_0897_E1.jpg",
            "cost": "@Cost@ @AbilityResourceName@",
            "cooldown": "@Cooldown@ sec %i:cooldown%",
            "description": "K'Santé se rue vers un allié et tous deux gagnent un bouclier. S'il n'y a pas d'allié, K'Santé se rue vers l'endroit ciblé (sur une plus courte distance) et gagne un bouclier.<br>",
