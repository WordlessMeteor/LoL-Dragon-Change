    "spells": [
        {
            "spellKey": "q",
            "name": "Frappe fleurie",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Lillia/HUD/Icons2D/Lillia_Icon_Q.png",
            "abilityVideoPath": "champion-abilities/0876/ability_0876_Q1.webm",
