    "passive": {
        "name": "Titan de bric-à-brac",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Rumble/HUD/Icons2D/Rumble_JunkyardTitan1.png",
        "abilityVideoPath": "champion-abilities/0068/ability_0068_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0068/ability_0068_P1.jpg",
        "description": "Chaque sort lancé par Rumble augmente sa Vapeur. Quand Rumble atteint 50% de Vapeur, il entre dans la Zone rouge, ce qui confère des effets bonus à ses compétences de base. Quand il atteint 100% de Vapeur, il entre en Surchauffe, ce qui lui octroie de la vitesse d'attaque bonus et lui permet d'infliger des dégâts supplémentaires avec ses attaques de base, mais l'empêche d'utiliser ses compétences pendant quelques secondes."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Lance-flammes",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Rumble/HUD/Icons2D/Rumble_Flamespitter.png",
            "abilityVideoPath": "champion-abilities/0068/ability_0068_Q1.webm",
            "abilityVideoImagePath": "champion-abilities/0068/ability_0068_Q1.jpg",
            "cost": "@Effect2Amount@ pts de Vapeur",
