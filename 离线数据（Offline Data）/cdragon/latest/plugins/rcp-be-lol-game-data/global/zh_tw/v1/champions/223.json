            "skinAugments": null,
            "description": "原本是鯰魚的貪啃奇曾經夢想過要魚躍龍門，成為一條龍。當燼從瀑布的封印中解放時，一顆魔法珍珠出現在瀑布的底下，引起了貪啃奇和寇格魔的注意。貪啃奇搶先一步搶下珍珠，變化為水流之龍神，製造了一個凶殘至極的漩渦。隨後的大規模破壞使他不由得大笑了起來。"
        }
    ],
    "passive": {
        "name": "品味獨到",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/TahmKench/HUD/Icons2D/TahmKenchP.png",
        "abilityVideoPath": "champion-abilities/0223/ability_0223_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0223/ability_0223_P1.jpg",
        "description": "貪啃奇將碩大身軀的力量展現在普攻上，他的普攻會根據自身的總生命獲得額外傷害。傷害敵方英雄會留下<spellName>品味獨到</spellName>的堆層。堆積至三層時，他可以對一名敵方英雄施放<spellName>大快朵頤</spellName>。"
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "毒舌",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/TahmKench/HUD/Icons2D/TahmKenchQ.png",
