            "emblems": null,
            "regionRarityId": 0,
            "rarityGemPath": null,
            "skinLines": [
                {
                    "id": 196
                }
            ],
            "description": "虽然他这人莫名有些避世，灵魂大赛的热心主办者还是向来到竞技场的各位观众献上热烈的欢迎！看看他，从俯视竞技场上方的王座凝视着各位参赛选手，眼中充满了期待！大家说，他这么孤僻，是不是太悲伤了？我们只能希望，他能从那高高的塔楼上一跃而下，将自己的满腔悲怆化为吞噬一切的怒火！请大家欢迎——维——尔——戈！"
        }
    ],
    "passive": {
        "name": "王权统御",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Viego/HUD/Icons2D/Viego_Passive.png",
        "abilityVideoPath": "champion-abilities/0234/ability_0234_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0234/ability_0234_P1.jpg",
        "description": "倒在维尔戈面前的敌方英雄会变为幽魂。透过攻击一个幽魂，维尔戈可以暂时夺取该英雄躯体的控制权，获得相当于他目标一部分最大生命的治愈效果并获得该英雄的基础技能和道具的使用权。他会将其终极技能替换为他自己终极技能的一次无消耗施法。"
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "殒落王者之剑",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Viego/HUD/Icons2D/Viego_Q.png",
