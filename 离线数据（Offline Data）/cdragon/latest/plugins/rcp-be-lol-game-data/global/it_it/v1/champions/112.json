        {
            "spellKey": "w",
            "name": "Campo gravitazionale",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Viktor/HUD/Icons2D/Viktor_W1.png",
            "abilityVideoPath": "champion-abilities/0112/ability_0112_W1.webm",
