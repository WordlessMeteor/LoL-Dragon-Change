        {
            "spellKey": "e",
            "name": "Slancio d'orgoglio",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/KSante/HUD/Icons2D/Icons_KSante_E.png",
            "abilityVideoPath": "champion-abilities/0897/ability_0897_E1.webm",
            "abilityVideoImagePath": "champion-abilities/0897/ability_0897_E1.jpg",
            "cost": "@Cost@ @AbilityResourceName@",
            "cooldown": "@Cooldown@ secondi di %i:cooldown%",
            "description": "K'Sante scatta verso un alleato ed entrambi ottengono uno scudo. Se non ci sono alleati, K'Sante scatta comunque verso la posizione con gittata ridotta e ottiene uno scudo.<br>",
            "dynamicDescription": "K'Sante scatta, ottenendo uno <shield>scudo da @TotalShield@</shield> per @ShieldDuration@ secondi. Se scatta verso un alleato, la distanza dello scatto aumenta sensibilmente e l'alleato ottiene uno <shield>scudo</shield>.<br><br><keywordMajor>Tutto per tutto</keywordMajor>: la velocità dello scatto di questa abilità è aumentata. Lo scatto senza un alleato ha gittata aumentata e permette di superare i muri.@SpellModifierDescriptionAppend@",
