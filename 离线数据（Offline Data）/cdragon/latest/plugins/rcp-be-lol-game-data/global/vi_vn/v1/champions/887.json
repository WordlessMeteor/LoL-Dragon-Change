    "passive": {
        "name": "Ngàn Nhát Cắt",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Gwen/HUD/Icons2D/Gwen_Passive.png",
        "abilityVideoPath": "champion-abilities/0887/ability_0887_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0887/ability_0887_P1.jpg",
        "description": "Đòn đánh của Gwen gây sát thương phép cộng thêm dựa theo số máu của mục tiêu. Cô được hồi lại một phần lượng sát thương hiệu ứng này gây ra lên tướng. "
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Xoẹt Xoẹt!",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Gwen/HUD/Icons2D/Gwen_Q.png",
