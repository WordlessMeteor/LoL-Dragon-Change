    "passive": {
        "name": "Abschwörung der Geister",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Aurora/HUD/Icons2D/AuroraPassive.Aurora.png",
        "abilityVideoPath": "champion-abilities/0893/ability_0893_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0893/ability_0893_P1.jpg",
        "description": "Auroras Fähigkeiten und Angriffe befreien Geister aus Gegnern, denen sie Schaden zufügt. Befreite Geister folgen Aurora, heilen sie und gewähren ihr zusätzliches Lauftempo."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Hex, hex!",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Aurora/HUD/Icons2D/AuroraQ.Aurora.png",
            "abilityVideoPath": "champion-abilities/0893/ability_0893_Q1.webm",
            "abilityVideoImagePath": "champion-abilities/0893/ability_0893_Q1.jpg",
            "cost": "@Cost@ @AbilityResourceName@",
            "cooldown": "@Cooldown@&nbsp;s %i:cooldown%",
            "description": "Aurora entsendet ein Geschoss, das jeden getroffenen Gegner verhext. Dann kann sie die Fähigkeit reaktivieren, um aktive Verhexungen zu sich zurückzuholen und unterwegs getroffenen Gegnern Schaden zuzufügen.",
            "dynamicDescription": "Feuert verhexte Energie in eine Richtung, die Gegnern <magicDamage>@damage@magischen Schaden</magicDamage> zufügt und sie für @MarkDuration@ Sekunden verflucht.<br><br><recast>Reaktivierung:</recast> Beendet die Verhexung und zieht einen Teil des Geists der Gegner zurück zu Aurora, wodurch auf dem Weg getroffene Gegner abhängig von ihrem fehlenden Leben <magicDamage>@Q2DamageMax@&nbsp;magischen Schaden</magicDamage> erleiden. Nach dem ersten Treffer wird der Schaden um 20&nbsp;% verringert.<br><br>Wenn die Wirkung nachlässt, reaktiviert Aurora die Fähigkeit automatisch.@SpellModifierDescriptionAppend@",
