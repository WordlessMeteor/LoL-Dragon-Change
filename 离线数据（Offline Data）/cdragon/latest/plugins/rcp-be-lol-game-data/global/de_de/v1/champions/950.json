    "passive": {
        "name": "Wir sind mehr",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Naafiri/HUD/Icons2D/Icons_Naafiri_P.png",
        "abilityVideoPath": "champion-abilities/0950/ability_0950_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0950/ability_0950_P1.jpg",
        "description": "Naafiri lässt Rudelgefährten erscheinen, die die Ziele ihrer Angriffe und Fähigkeiten angreifen."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Dolch der Düsteren",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Naafiri/HUD/Icons2D/Icons_Naafiri_Q.png",
            "abilityVideoPath": "champion-abilities/0950/ability_0950_Q1.webm",
            "abilityVideoImagePath": "champion-abilities/0950/ability_0950_Q1.jpg",
            "cost": "@Cost@ @AbilityResourceName@",
            "cooldown": "@Cooldown@&nbsp;s %i:cooldown%",
            "description": "Naafiri wirft bis zu zwei Dolche, die eine Blutung verursachen oder zusätzlichen Schaden zufügen, wenn das Ziel bereits blutet.<br><br>Die Rudelgefährten greifen sofort den Champion an, der mit dieser Fähigkeit getroffen wurde.<br>",
            "dynamicDescription": "Naafiri wirft Klingen erfüllt mit der Macht der Düsteren, die <physicalDamage>@spell.NaafiriQ:TotalDamageFirstCast@&nbsp;normalen Schaden</physicalDamage> verursachen und über @spell.NaafiriQ:BleedDuration@&nbsp;Sekunden hinweg eine Blutung auslösen, die <physicalDamage>@spell.NaafiriQ:TotalBleedDamage@&nbsp;normalen Schaden</physicalDamage> verursacht.<br><br>Naafiri kann diese Fähigkeit <recast>reaktivieren</recast>. Wenn getroffene Gegner durch diese Fähigkeit bereits bluten, erleiden sie stattdessen den verbleibenden Blutungsschaden und zusätzlich zwischen <physicalDamage>@spell.NaafiriQ:TotalMinDamageSecondCast@</physicalDamage> und <physicalDamage>@spell.NaafiriQ:TotalMaxDamageSecondCast@&nbsp;normalen Schaden</physicalDamage> (basierend auf dem fehlenden Leben). Ist das getroffene Ziel ein Champion oder ein großes Monster, stellt Naafiri <healing>@spell.NaafiriQ:TotalHealSecondCast@&nbsp;Leben</healing> wieder her.<br><br><keywordMajor>Rudelgefährten</keywordMajor> stürzen sich auf den ersten getroffenen Champion und greifen ihn @spell.NaafiriP:PackmateTauntDuration@&nbsp;Sekunden lang an.<br><br>@SpellModifierDescriptionAppend@",
