    "passive": {
        "name": "Prophetin eines alten Gottes",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Illaoi/HUD/Icons2D/Illaoi_P.png",
        "abilityVideoPath": "champion-abilities/0420/ability_0420_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0420/ability_0420_P1.jpg",
        "description": "Illaoi und die <font color='#669900'>Gefäße</font>, die sie erschafft, lassen auf nahem unpassierbaren Terrain Tentakel entstehen. Tentakel schlagen nach Geistern, <font color='#669900'>Gefäßen</font> und Opfern von Illaois „Harter Lektion“ aus. Tentakel fügen getroffenen Gegnern normalen Schaden zu und heilen Illaoi, wenn sie einen Champion treffen."
    },
