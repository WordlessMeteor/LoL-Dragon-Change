    "spells": [
        {
            "spellKey": "q",
            "name": "힘의 흡수",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Viktor/HUD/Icons2D/Viktor_Q1.png",
            "abilityVideoPath": "champion-abilities/0112/ability_0112_Q1.webm",
            "abilityVideoImagePath": "champion-abilities/0112/ability_0112_Q1.jpg",
            "cost": "@AbilityResourceName@ @Cost@",
