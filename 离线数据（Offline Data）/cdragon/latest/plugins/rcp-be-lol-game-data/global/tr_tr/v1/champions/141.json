    "passive": {
        "name": "Darkin Tırpan",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Kayn/HUD/Icons2D/Kayn_Passive_Primary.png",
        "abilityVideoPath": "champion-abilities/0141/ability_0141_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0141/ability_0141_P1.jpg",
        "description": "Kayn elinde kadim bir silah taşır ve bu silahın içindeki Darkin Rhaast'la hâkimiyet mücadelesi verir. Ya <font color='#fe5c50'>Darkin</font> galip gelir ya da Kayn Rhaast'ı alt ederek <font color='#8484fb'>Gölge Suikastçı</font> olur.<br><br><font color='#fe5c50'>Darkin:</font> Şampiyonlara verilen yetenek hasarının belli bir yüzdesi kadar iyileşir.<br><br><font color='#8484fb'>Gölge Suikastçı:</font> Rakip şampiyonlarla girilen çatışmaların ilk birkaç saniyesinde ilave hasar verir."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Karanlık Hasat",
