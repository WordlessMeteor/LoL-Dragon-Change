    "passive": {
        "name": "Nekonečná radost",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Nilah/HUD/Icons2D/NIlahP.png",
        "abilityVideoPath": "champion-abilities/0895/ability_0895_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0895/ability_0895_P1.jpg",
        "description": "Nilah získává více zkušeností za dorážení poskoků a posiluje a sdílí léčení a štíty, které v okolí sesílají její spojenci."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Éterický meč",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Nilah/HUD/Icons2D/NilahQ.png",
            "abilityVideoPath": "champion-abilities/0895/ability_0895_Q1.webm",
            "abilityVideoImagePath": "champion-abilities/0895/ability_0895_Q1.jpg",
            "cost": "@AbilityResourceName@: @Cost@",
            "cooldown": "@Cooldown@ sek. %i:cooldown%",
            "description": "Nilah práskne bičovou čepelí ve zvoleném směru, zasáhne všechny nepřátele v řadě a způsobí jim poškození. Tato akce jí na krátkou dobu prodlouží dosah útoků.",
            "dynamicDescription": "<spellPassive>Pasivní efekt:</spellPassive> Nilah získá @CritArmorPen@ k průraznosti brněním a její útoky proti šampionům jí obnovují <healing>zdraví ve výši @CritLifesteal@ způsobeného poškození</healing>. Přebytečné léčení z tohoto efektu se mění na <shield>štít</shield> s životností @ShieldDuration@&nbsp;sek.<br><br><spellActive>Aktivace:</spellActive> Nilah práskne bičem a způsobí <physicalDamage>@DamageCalc@ bodů fyzického poškození</physicalDamage>, tato hodnota se zvyšuje v závislosti na její šanci na kritický zásah. Zasáhne-li nějakou nepřátelskou jednotku nebo budovu, získá Nilah na @BuffDuration@&nbsp;sek. 125 k dosahu útoků a <attackSpeed>@BonusAttackSpeedCalc@&nbsp;% k rychlosti útoků</attackSpeed>, její útoky zasahují jednotky v kuželové výseči a způsobují jim <physicalDamage>@AttackTotalDamageTooltip@ bodů fyzického poškození</physicalDamage>.<br>@SpellModifierDescriptionAppend@",
