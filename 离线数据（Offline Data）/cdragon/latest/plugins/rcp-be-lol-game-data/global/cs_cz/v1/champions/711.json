    "passive": {
        "name": "Zkáza a chmury",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Vex/HUD/Icons2D/Icons_Vex_Passive.png",
        "abilityVideoPath": "champion-abilities/0711/ability_0711_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0711/ability_0711_P1.jpg",
        "description": "Vex pravidelně získává posílení, díky kterému svou příští základní schopností zastraší nepřátele a přeruší jejich přeběhy. Kdykoliv v jejím okolí použije nějaký nepřítel přeběh, umístí na něj Vex značku, jejímž spotřebováním způsobí bonusové poškození a zároveň si zkrátí přebíjecí dobu svého posíleného stavu."
    },
