    "passive": {
        "name": "Odvážlivý impulz",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Samira/HUD/Icons2D/SamiraP.png",
        "abilityVideoPath": "champion-abilities/0360/ability_0360_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0360/ability_0360_P1.jpg",
        "description": "Úspěšně provedenými zásahy útoků a schopností, které se liší od předchozího zásahu, vytváří Samira kombo. Samiřiny útoky na kontaktní vzdálenost způsobují dodatečné magické poškození. Když Samira zasáhne útokem protivníka, na kterého působí nějaký <status>znehybňující</status> efekt, přiběhne k němu na dosah svých útoků. Pokud je nepřítel <status>vyhozený do vzduchu</status>, prodlouží na chvíli jeho <status>vyhození do vzduchu</status>."
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Šmrnc",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Samira/HUD/Icons2D/SamiraQ.png",
