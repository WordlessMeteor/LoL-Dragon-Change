    "passive": {
        "name": "The Hitman and the Seer",
        "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Aphelios/HUD/Icons2D/ApheliosP.png",
        "abilityVideoPath": "champion-abilities/0523/ability_0523_P1.webm",
        "abilityVideoImagePath": "champion-abilities/0523/ability_0523_P1.jpg",
        "description": "Aphelios ใช้อาวุธ Lunari 5 ชิ้นซึ่งสร้างขึ้นโดยน้องสาวของเขา Alune เขาสามารถใช้งาน 2 อาวุธได้ในเวลาเดียวกัน: อาวุธหลักและอาวุธรอง ในแต่ละอาวุธมีการโจมตีและสกิลที่แตกต่างกันออกไป การโจมตีและสกิลจะต้องใช้กระสุน เมื่อกระสุนหมด Aphelios จะทิ้งอาวุธของเขา และ Alune จะเรียกอาวุธอันถัดไปขึ้นมาจาก 5 ชิ้น "
    },
    "spells": [
        {
            "spellKey": "q",
            "name": "Weapon Abilites",
            "abilityIconPath": "/lol-game-data/assets/ASSETS/Characters/Aphelios/HUD/Icons2D/ApheliosQ.png",
            "abilityVideoPath": "champion-abilities/0523/ability_0523_Q1.webm",
